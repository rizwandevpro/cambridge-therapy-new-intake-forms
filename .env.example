# Resend (https://resend.com) — same account/domain as the existing forms app.
RESEND_API_KEY=

# Where completed packets are delivered.
CLINIC_EMAIL=reports@cambridgemich.com

# Verified sender on the Resend domain.
FROM_EMAIL="Cambridge Psychiatry Forms <reports@cambridgemich.com>"

# Printed in the "Practice information" block on page 1 of the PDF.
PRACTICE_EMAIL=
# Office phone numbers are set per location in app/lib/config.js (LOCATIONS).
# This is only a fallback for a location with no number there.
PRACTICE_PHONE=
